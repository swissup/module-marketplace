{
    "name": "swissup/module-marketplace",
    "description": "One-Click modules and themes downloader/installer",
    "keywords": [
        "marketplace",
        "magento marketplace",
        "module manager",
        "theme manager",
        "installer"
    ],
    "type": "magento2-module",
    "version": "1.12.1",
    "license": "MIT",
    "require": {
        "composer/composer": "*",
        "magento/framework": ">=101.0",
        "magento/module-backend": ">=100.2",
        "magento/module-catalog": "*",
        "magento/module-cms": "*",
        "magento/module-deploy": ">=100.0",
        "magento/module-theme": "*",
        "magento/module-ui": ">=101.0",
        "monolog/monolog": "*",
        "psr/log": "*",
        "symfony/console": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Swissup\\Marketplace\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
